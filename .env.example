# PJAR Client Configuration
# Copy file ini menjadi .env dan edit sesuai kebutuhan

# Server URL - ubah sesuai dengan alamat Ubuntu server
# LOCAL (untuk testing)
SERVER_URL=http://localhost:5000

# REMOTE (untuk production)
# SERVER_URL=http://192.168.1.100:5000

# CLOUDFLARE TUNNEL (untuk public access)
# SERVER_URL=https://pjar.your-tunnel.com
